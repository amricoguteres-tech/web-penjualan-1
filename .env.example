# PostgreSQL
POSTGRES_USER="nebula"
POSTGRES_PASSWORD=""
POSTGRES_DB="nebula_x"
DATABASE_URL="postgresql://nebula@localhost:5432/nebula_x?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL=""

# Auth.js. Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="false"
# Set true only behind a proxy that strips and rewrites X-Forwarded-For.
TRUST_PROXY_HEADERS="false"
CSP_ENFORCE="false"
CSP_IMAGE_ORIGINS=""

# Optional one-time administrator bootstrap. Use a unique password with 16+ characters.
NEBULA_ADMIN_EMAIL=""
NEBULA_ADMIN_PASSWORD=""

# Midtrans sandbox credentials. Keep the server key on the server only.
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Optional infrastructure adapters.
REDIS_URL=""
S3_REGION="auto"
EMAIL_FROM=""
EMAIL_SERVER=""
EMAIL_OUTBOX_ENCRYPTION_KEY=""
REQUIRE_EMAIL_VERIFICATION="false"
OUTBOX_WORKER_SECRET=""
PAYMENT_RECONCILIATION_SECRET=""
EMAIL_OUTBOX_MAX_ATTEMPTS="8"
EMAIL_OUTBOX_RETRY_BASE_MS="30000"
EMAIL_OUTBOX_RETRY_MAX_MS="21600000"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
